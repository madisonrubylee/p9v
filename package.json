{
  "name": "@p9v/core",
  "version": "0.2.0",
  "description": "Prefetch → View. A Relay-style REST + TanStack Query data layer with route enforcement and browser waterfall Devtools.",
  "keywords": [
    "react",
    "nextjs",
    "next.js",
    "app-router",
    "react-query",
    "tanstack-query",
    "@tanstack/react-query",
    "react query waterfall",
    "tanstack query prefetch",
    "nextjs prefetch react query",
    "request waterfall",
    "request-waterfall",
    "nested fetch react",
    "relay style react query",
    "relay",
    "data masking react",
    "data-masking",
    "fragment colocation",
    "fragment",
    "colocation",
    "prefetch",
    "waterfall",
    "devtools",
    "suspense",
    "rsc",
    "server-components",
    "hydration"
  ],
  "license": "MIT",
  "author": "madisonrubylee <lamantciel@naver.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madisonrubylee/p9v.git"
  },
  "homepage": "https://github.com/madisonrubylee/p9v#readme",
  "bugs": {
    "url": "https://github.com/madisonrubylee/p9v/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "p9v": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js",
      "require": "./dist/devtools/index.cjs"
    },
    "./devtools/react": {
      "types": "./dist/devtools/react.d.ts",
      "import": "./dist/devtools/react.js",
      "require": "./dist/devtools/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.19.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^15.11.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.15.1"
}
